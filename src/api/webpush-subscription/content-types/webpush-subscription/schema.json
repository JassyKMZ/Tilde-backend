{
  "kind": "collectionType",
  "collectionName": "webpush_subscriptions",
  "info": {
    "singularName": "webpush-subscription",
    "pluralName": "webpush-subscriptions",
    "displayName": "WebPush Subscription",
    "description": "Stores browser push subscriptions for Web Push (non-FCM browsers)"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "endpoint": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "p256dh": {
      "type": "string",
      "required": true
    },
    "auth": {
      "type": "string",
      "required": true
    },
    "browser": {
      "type": "string"
    },
    "userAgent": {
      "type": "text"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "webpush_subscriptions"
    }
  }
}
