{
  "kind": "collectionType",
  "collectionName": "release_anmeldungen",
  "info": {
    "singularName": "release-anmeldung",
    "pluralName": "release-anmeldungen",
    "displayName": "Release-Anmeldung",
    "description": "Anmeldungen zum Release-Tag (/release-anmeldung, nur per Link erreichbar)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "personen": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 1,
      "max": 10
    },
    "anmerkung": {
      "type": "text"
    },
    "abgesagt": {
      "type": "boolean",
      "default": false
    },
    "abgesagtAm": {
      "type": "datetime"
    },
    "abmeldeToken": {
      "type": "string",
      "private": true,
      "unique": true
    }
  }
}
