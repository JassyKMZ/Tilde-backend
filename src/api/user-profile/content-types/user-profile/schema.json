{
  "kind": "collectionType",
  "collectionName": "user_profiles",
  "info": {
    "name": "User Profile",
    "singularName": "user-profile",
    "pluralName": "user-profiles",
    "displayName": "User Profile",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "user_profile"
    },
    "fullName": {
      "type": "string"
    },
    "bookmarks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::post.post",
      "inversedBy": "user_profiles"
    },
    "reminders": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::post.post",
      "inversedBy": "user_reminders"
    },
    "kategories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "user_profiles"
    },
    "kinder": {
      "type": "component",
      "component": "profil.kind",
      "repeatable": true,
      "max": 14
    },
    "gruppen": {
      "type": "component",
      "component": "profil.gruppe",
      "repeatable": true
    },
    "push_subscriptions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::push-subscriptions.push-subscription",
      "mappedBy": "user_profile"
    },
    "pushNotificationsEnabled": {
      "type": "boolean"
    },
    "minAge": {
      "type": "integer",
      "min": 0,
      "max": 99
    },
    "maxAge": {
      "type": "integer",
      "min": 0,
      "max": 99
    },
    "testUser": {
      "type": "boolean"
    },
    "saved_tipps": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tipp-section.tipp-section",
      "mappedBy": "user_profiles"
    },
    "onboardingComplete": {
      "type": "boolean",
      "default": false
    },
    "identity": {
      "type": "json"
    }
  }
}
