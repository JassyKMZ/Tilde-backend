{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titel": {
      "type": "string",
      "required": true
    },
    "bild": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "summary": {
      "type": "text"
    },
    "beschreibung": {
      "type": "blocks",
      "required": true
    },
    "eventDate": {
      "type": "datetime",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "postType"
            },
            "event"
          ]
        }
      }
    },
    "veranstaltungsort": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::veranstaltungsort.veranstaltungsort",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "postType"
            },
            "event"
          ]
        }
      }
    },
    "veranstaltungstyp": {
      "type": "enumeration",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "postType"
            },
            "event"
          ]
        }
      },
      "default": "Veranstaltung",
      "enum": [
        "Abrufveranstaltung",
        "Kurs",
        "Workshop",
        "Seminar",
        "Fortbildung",
        "Veranstaltung",
        "Schülerworkshop"
      ]
    },
    "user_profiles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::user-profile.user-profile",
      "mappedBy": "bookmarks"
    },
    "saved_tipp_profiles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::user-profile.user-profile",
      "mappedBy": "saved_tipps"
    },
    "kategories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "posts"
    },
    "institution": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::institution.institution",
      "inversedBy": "posts"
    },
    "minAge": {
      "type": "integer",
      "min": 0,
      "max": 99
    },
    "maxAge": {
      "type": "integer",
      "min": 0,
      "max": 99
    },
    "kostenpflichtig": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "postType"
            },
            "event"
          ]
        }
      },
      "default": false
    },
    "user_reminders": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::user-profile.user-profile",
      "mappedBy": "reminders"
    },
    "dauer": {
      "type": "decimal",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "postType"
            },
            "event"
          ]
        }
      }
    },
    "trainer": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "postType"
            },
            "event"
          ]
        }
      }
    },
    "annotation": {
      "type": "text"
    },
    "publish": {
      "type": "boolean",
      "default": false
    },
    "galerie": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "veranstalter": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::veranstalter.veranstalter",
      "inversedBy": "posts"
    },
    "teilnehmer": {
      "type": "integer",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "postType"
            },
            "event"
          ]
        }
      }
    },
    "availability": {
      "type": "enumeration",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "postType"
            },
            "event"
          ]
        }
      },
      "enum": [
        "Vor Ort",
        "Online",
        "Hybrid"
      ]
    },
    "preis": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "kostenpflichtig"
            },
            true
          ]
        }
      }
    },
    "linkTo": {
      "type": "string"
    },
    "target_roles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::profile-role.profile-role",
      "inversedBy": "targeted_posts"
    },
    "identity": {
      "type": "json",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        },
        "content-type-builder": {
          "visible": false
        }
      }
    },
    "postType": {
      "type": "enumeration",
      "enum": [
        "event",
        "tipp",
        "beitrag"
      ]
    }
  }
}
