{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titel": {
      "type": "string",
      "required": true
    },
    "beschreibung": {
      "type": "blocks",
      "required": true
    },
    "bild": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "isEvent": {
      "type": "boolean",
      "required": true
    },
    "eventDate": {
      "type": "datetime",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isEvent"
            },
            true
          ]
        }
      }
    },
    "veranstaltungsort": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::veranstaltungsort.veranstaltungsort",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isEvent"
            },
            true
          ]
        }
      }
    },
    "veranstaltungstyp": {
      "type": "enumeration",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isEvent"
            },
            true
          ]
        }
      },
      "enum": [
        "Abrufveranstaltung",
        "Kurs",
        "Workshop",
        "Veranstaltung",
        "Schülerworkshop"
      ]
    },
    "user_profiles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::user-profile.user-profile",
      "mappedBy": "bookmarks"
    },
    "kategories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "posts"
    },
    "klasses": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::klasse.klasse",
      "mappedBy": "posts"
    },
    "institution": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::institution.institution",
      "inversedBy": "posts"
    },
    "minAge": {
      "type": "integer",
      "min": 0,
      "max": 18
    },
    "maxAge": {
      "type": "integer",
      "min": 0,
      "max": 18
    },
    "kostenpflichtig": {
      "type": "boolean",
      "default": false
    },
    "user_profiles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::user-profile.user-profile",
      "mappedBy": "bookmarks"
    },
    "user_reminders": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::user-profile.user-profile",
      "mappedBy": "reminders"
    }
  }
}
